{
  "name": "da-moa",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "db:migrate": "node --import tsx scripts/migrate-auth.mjs",
    "db:seed:test-accounts": "node --import tsx scripts/seed-test-accounts.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 scripts/*.integration.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ably": "^2.28.0",
    "lucide-react": "^1.14.0",
    "next": "^16.1.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "swagger-ui-react": "^5.32.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/env": "^16.3.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
