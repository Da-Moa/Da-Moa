{
  "name": "da-moa",
  "private": true,
  "version": "0.7.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "db:local:up": "docker compose up -d --wait postgres minio && docker compose exec -T minio sh -c 'mc alias set local http://127.0.0.1:9000 \"$MINIO_ROOT_USER\" \"$MINIO_ROOT_PASSWORD\" >/dev/null && mc mb --ignore-existing local/da-moa-receipts-dev'",
    "db:local:down": "docker compose down",
    "db:migrate": "node --import tsx scripts/migrate-auth.mjs",
    "db:seed:test-accounts": "node --import tsx scripts/seed-test-accounts.mjs",
    "dev": "NODE_ENV=development nest start --watch",
    "build": "prisma generate && nest build && next build",
    "start": "NODE_ENV=production nest start",
    "test": "SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test src/backend/test/unit/*.test.ts src/backend/test/unit/*.test.mjs src/frontend/test/unit/*.test.ts src/frontend/test/unit/*.test.mjs",
    "test:integration": "SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test --test-concurrency=1 src/backend/test/integration/*.integration.test.ts",
    "typecheck": "tsc --project tsconfig.check.json --noEmit --incremental false && tsc --project tsconfig.backend.json --noEmit --incremental false",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "build:backend": "prisma generate && nest build",
    "test:smoke": "SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test --test-concurrency=1 src/backend/test/integration/routes.integration.test.ts",
    "test:browser": "playwright test",
    "test:domain": "SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test --test-concurrency=1 src/backend/test/domain/*.domain.test.ts",
    "test:scenario": "SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test --test-concurrency=1 src/backend/test/scenario/*.scenario.test.ts",
    "test:all": "npm test && npm run test:domain && npm run test:integration && npm run test:scenario",
    "test:transport": "npm run build:backend && SWC_NODE_PROJECT=tsconfig.backend.json node --import @swc-node/register/esm-register --test --test-concurrency=1 src/backend/test/transport/*.test.ts src/backend/test/transport/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@edge-runtime/cookies": "^6.0.0",
    "@jsquash/avif": "2.1.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@next/env": "^16.3.4",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@smithy/core": "3.35.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "graphile-worker": "0.18.0",
    "jose": "6.2.12",
    "korean-account": "0.3.1",
    "lucide-react": "^1.14.0",
    "nanoid": "6.0.2",
    "next": "^16.1.6",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "sql-formatter": "^15.9.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "1.64.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "chokidar": "^4.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "node-mocks-http": "^1.18.1",
    "prettier": "3.9.9",
    "prisma": "7.9.1",
    "swc-loader": "^0.2.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.4.3",
      "swagger-ui-dist": "5.33.1"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@scarf/scarf": false
  }
}
