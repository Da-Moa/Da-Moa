{
  "name": "da-moa",
  "private": true,
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "db:local:up": "docker compose up -d --wait postgres minio && docker compose exec -T minio sh -c 'mc alias set local http://127.0.0.1:9000 \"$MINIO_ROOT_USER\" \"$MINIO_ROOT_PASSWORD\" >/dev/null && mc mb --ignore-existing local/da-moa-receipts-dev'",
    "db:local:down": "docker compose down",
    "db:migrate": "node --import tsx scripts/migrate-auth.mjs",
    "db:seed:test-accounts": "node --import tsx scripts/seed-test-accounts.mjs",
    "dev": "NODE_ENV=development node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --import ./scripts/test-server-only.mjs --import tsx --test src/lib/*.test.ts src/lib/*.test.mjs",
    "test:integration": "node --import ./scripts/test-server-only.mjs --import tsx --test --test-concurrency=1 scripts/*.integration.test.ts scripts/*.integration.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@jsquash/avif": "2.1.1",
    "@smithy/core": "3.35.0",
    "graphile-worker": "0.18.0",
    "korean-account": "0.3.1",
    "lucide-react": "^1.14.0",
    "next": "^16.1.6",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "sql-formatter": "^15.9.0",
    "swagger-ui-react": "^5.32.14",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/env": "^16.3.4",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
