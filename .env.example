# Kakao Developers의 REST API 키 (OIDC client_id)
KAKAO_REST_API_KEY=
# 카카오 콘솔에 등록한 Redirect URI
KAKAO_REDIRECT_URI=http://localhost:3000/auth/v1/kakao
# 카카오 콘솔에서 Client Secret을 사용하도록 설정한 경우에만 입력
KAKAO_CLIENT_SECRET=
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
AUTH_JWT_SECRET=
# 로컬 개발 PostgreSQL. Vercel Production의 같은 키에는 Neon URL을 등록
DATABASE_URL=postgresql://da_moa:da_moa_local@127.0.0.1:55432/da_moa_dev
# Ably 앱의 서버 전용 API 키. 개발·Preview·Production은 서로 다른 Ably 앱/키 사용
ABLY_API_KEY=
# 개발 서버 접근을 허용할 호스트. 여러 개는 쉼표로 구분, 변경 후 서버 재시작
NEXT_DEV_ALLOWED_ORIGINS=192.168.219.141

# 금융결제원 이용기관 API 명세서 v3.3.6. 실제 제공받은 테스트/운영 키를 사용
OPENBANKING_ENV=test
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
# 이용기관코드 10자리 (거래고유번호의 앞 10자리)
OPENBANKING_CLIENT_USE_CODE=
# 금융결제원 서비스 설정의 Callback URL과 정확히 일치해야 함
OPENBANKING_REDIRECT_URI=http://localhost:3000/auth/v1/openbanking
OPENBANKING_SCOPES="login inquiry"
# 서로 다른 32바이트 base64 값 (각각 openssl rand -base64 32)
OPENBANKING_TOKEN_ENCRYPTION_KEY=
OPENBANKING_REQUEST_HMAC_KEY=
