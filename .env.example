# Kakao Developers의 REST API 키 (OIDC client_id)
KAKAO_REST_API_KEY=
# 카카오 콘솔에 등록한 Redirect URI. 여러 개는 쉼표로 구분하며 접속 주소에 맞춰 선택
KAKAO_REDIRECT_URI=http://localhost:3000/auth/v1/kakao
# 내부 IP도 사용할 경우 두 URI를 카카오에 각각 등록하고 아래처럼 설정
# KAKAO_REDIRECT_URI=http://localhost:3000/auth/v1/kakao,http://192.168.219.102:3000/auth/v1/kakao
# 카카오 REST API 키의 Client Secret이 ON이면 필수 (신규 키는 기본 ON)
KAKAO_CLIENT_SECRET=
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
AUTH_JWT_SECRET=
# 로컬 개발 PostgreSQL. OCI 앱 컨테이너에서는 Compose 서비스명 postgres:5432를 사용
DATABASE_URL=postgresql://da_moa:da_moa_local@127.0.0.1:55432/da_moa_dev
# 쿼리 전수 조사: true일 때 SQL을 줄바꿈·들여쓰기하여 출력 (바인딩 값·결과 행 제외)
DB_QUERY_LOG=false
# 추가창 드래그 속도 표시: true로 켜기. 개발 서버 재시작 / 운영 빌드 재실행 필요
NEXT_PUBLIC_SHEET_DRAG_SPEED_DEBUG=false
# 영수증 저장용 비공개 MinIO 버킷. 로컬 테스트와 운영 환경은 별도 버킷/키 사용
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=da-moa-receipts-dev
# 아래 키는 localhost에만 바인딩한 로컬 Docker 전용. 운영에는 앱 전용 키 사용
MINIO_ACCESS_KEY=da_moa_local
MINIO_SECRET_KEY=da_moa_minio_local
# 개발 서버 접근 허용 호스트는 미설정 시 현재 내부 IPv4를 자동 허용
# 직접 지정할 경우 쉼표로 구분하며, 빈 값은 추가 허용 없음. 변경 후 서버 재시작
# NEXT_DEV_ALLOWED_ORIGINS=192.168.219.141
